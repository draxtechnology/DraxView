<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BMX</RootNamespace>
    <AssemblyName>BMX</AssemblyName>
    <Version>0.1.0</Version>
    <Product>BMX</Product>
    <Company>Drax Technology</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same MQTTnet the service and MqttMonitor use, so the dialect matches. -->
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>

</Project>
