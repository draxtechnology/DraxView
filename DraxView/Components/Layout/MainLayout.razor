@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <a class="topbar-brand" href="/" aria-label="DraxView home">
            <DraxLogo Size="30" />
            <span class="product">
                <span class="product-name">DraxView</span>
                <span class="product-tag">Alarm events</span>
            </span>
        </a>
        <nav class="topnav">
            <NavLink href="/" Match="NavLinkMatch.All">Events</NavLink>
            <NavLink href="/settings">Settings</NavLink>
        </nav>
        <div class="topbar-right">
            <AuthorizeView>
                <Authorized>
                    <span class="who">@context.User.Identity?.Name</span>
                    <form method="post" action="/logout" class="inline">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-quiet">Sign out</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="content">
        @Body
    </main>

    <footer class="footer">
        <span>Drax Technology</span>
        <span class="dot">·</span>
        <span>DraxView @(typeof(Program).Assembly.GetName().Version?.ToString(3))</span>
        <span class="dot">·</span>
        <span>Self-contained operator display</span>
    </footer>
</div>
