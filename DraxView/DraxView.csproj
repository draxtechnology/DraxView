<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DraxView</RootNamespace>
    <AssemblyName>DraxView</AssemblyName>
    <!-- Same convention as the service (AssemblyInfo 1.0.0.N + Product.wxs 1.0.N) and the client (FileVersion 1.0.0.N): bump both together. -->
    <Version>1.0.3</Version>
    <FileVersion>1.0.0.3</FileVersion>
    <Product>DraxView</Product>
    <Company>Drax Technology</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same MQTTnet the service and MqttMonitor use, so the dialect matches. -->
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>

</Project>
